#version 430 core
layout(local_size_x = 64) in;

layout(std430, binding = 0) readonly buffer TransformBuf {
    vec4 xzyr[];
};
layout(std430, binding = 1) writeonly buffer VisibleBuf {
    uint visible_indices[];
};
layout(std430, binding = 2) buffer IndirectBuf {
    uint indexCount;
    uint instanceCount;
    uint firstIndex;
    int  baseVertex;
    uint baseInstance;
};
layout(std430, binding = 3) readonly buffer FactionBuf {
    uint factions[];
};

uniform vec3  camPos;
uniform float near_sq;
uniform float far_sq;
uniform int   total_count;
uniform vec4  frustumPlanes[4];

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= uint(total_count)) return;

    vec4 data = xzyr[idx];
    vec3 pos  = vec3(data.x, data.z, data.y);
    if (pos.x >= 1e8) return;

    vec3 d = pos - camPos;
    float dsq = dot(d, d);
    if (dsq >= far_sq) return;

    for (int p = 0; p < 4; ++p) {
        if (dot(frustumPlanes[p].xyz, pos) + frustumPlanes[p].w < -1.0) return;
    }

    uint visIdx = atomicAdd(instanceCount, 1u);
    visible_indices[visIdx] = idx;
}
